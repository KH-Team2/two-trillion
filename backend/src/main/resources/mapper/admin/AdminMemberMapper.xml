<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hoperefund.admin.mapper.AdminMemberMapper">

    <!--
        [추가 11/23 고은] 목록 · 개수 쿼리가 같이 쓰는 검색 조건 (F-21 접근 기록과 같은 방식)
        이유: 두 쿼리에 조건을 따로 쓰면 한쪽만 고쳐서 「목록 15건 · 전체 20건」처럼 어긋날 수 있어요
        - keyword: 이메일 일부 (대소문자 상관없이 · 이메일은 DB에 소문자로만 저장됨 CK_MEMBER_EMAIL_LOWER)
          [수정 11/23 고은] NAME 검색 삭제 · 이유: v3.5부터 이름을 받지 않음
        - role: USER / ADMIN · status: ACTIVE / WITHDRAWN (비어 있으면 조건 없음)
    -->
    <sql id="searchCondition">
        <where>
            <if test="keyword != null and keyword != ''">
                AND EMAIL LIKE '%' || LOWER(#{keyword}) || '%'
            </if>
            <if test="role != null and role != ''">
                AND ROLE = #{role}
            </if>
            <if test="status != null and status != ''">
                AND STATUS = #{status}
            </if>
        </where>
    </sql>

    <!-- F-20: 마스킹된 회원 목록 조회 (정규식을 통한 개인정보 보호 처리) -->
    <select id="selectMaskedMemberList" resultType="com.hoperefund.admin.dto.MaskedMemberResponseDto">
        SELECT
            MEMBER_ID AS memberId,
            <!--
                [수정 11/23 고은] 이메일 마스킹 규칙 · 이유: 원래 식은 @ 앞이 2글자 이하면 하나도 안 가려졌어요
                INSTR(EMAIL, '@'): @가 몇 번째 글자인지 · SUBSTR(EMAIL, n): n번째 글자부터 끝까지
                ① @ 앞이 1~2글자 (INSTR이 2 또는 3) → 앞부분을 전부 *** 로   예) ab@x.com → ***@x.com
                ② 그 외 → REGEXP_REPLACE(정규식 바꾸기)로 앞 2글자만 남기고 *** 로
                   ^([^@]{2}) : 맨 앞 2글자(\1로 다시 씀) · [^@]* : @ 전까지 나머지(지움) · (@.*)$ : @부터 끝(\2로 다시 씀)
                   예) test1234@naver.com → te***@naver.com
            -->
            CASE
                WHEN INSTR(EMAIL, '@') &lt;= 3 THEN '***' || SUBSTR(EMAIL, INSTR(EMAIL, '@'))
                ELSE REGEXP_REPLACE(EMAIL, '^([^@]{2})[^@]*(@.*)$', '\1***\2')
            END AS email,
            ROLE AS role,
            STATUS AS status,
            TO_CHAR(CREATED_AT, 'YYYY-MM-DD') AS createdAt
        FROM MEMBER
        <include refid="searchCondition"/>
        ORDER BY MEMBER_ID DESC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <!-- [추가 11/23 고은] 검색 조건에 맞는 전체 회원 수 -->
    <select id="countMembers" resultType="int">
        SELECT COUNT(*)
        FROM MEMBER
        <include refid="searchCondition"/>
    </select>

    <!-- [수정 11/23 고은] 권한 변경 전 검사용 (selectMemberById에서 이름 · 이메일 빼고 STATUS 추가) -->
    <select id="selectRoleTarget" resultType="com.hoperefund.admin.dto.AdminMemberRoleTargetDto">
        SELECT
            MEMBER_ID AS memberId,
            ROLE AS role,
            STATUS AS status,
            GENDER AS gender
        FROM MEMBER
        WHERE MEMBER_ID = #{memberId}
    </select>

    <!-- F-20: 회원 권한 업데이트 -->
    <update id="updateMemberRole">
        UPDATE MEMBER
        SET ROLE = #{role},
            UPDATED_AT = SYSDATE
        WHERE MEMBER_ID = #{memberId}
    </update>

</mapper>
