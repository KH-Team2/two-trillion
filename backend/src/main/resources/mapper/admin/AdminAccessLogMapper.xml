    <!--
        F-21: 접근 기록 및 로그인 실패 모니터링 조회 (최신순 · 페이지)
        [수정 11/20] PR #45 리뷰 반영
          ① ACCESS_ID → LOG_ID AS accessId · ORDER BY도 LOG_ID (ACCESS_LOG에 ACCESS_ID 칸이 없어 ORA-00904)
          ② FAIL_COUNT → M.LOGIN_FAIL_COUNT (ACCESS_LOG에 FAIL_COUNT 칸이 없음 · 실패 횟수는 MEMBER에 있음)
          ③ LEFT JOIN MEMBER: 없는 아이디로 실패한 기록은 MEMBER_ID가 비어 있어서
             INNER JOIN(그냥 JOIN)이면 그 기록이 목록에서 사라짐 → LEFT JOIN은 MEMBER가 없어도 기록은 남기고 회원 칸만 null
          ④ SCREEN 칸 추가 조회 (어느 화면/API 접근인지)
        [추가 11/20] M.LOCKED_UNTIL(잠금 시각) · ipFailCount(같은 IP의 실패 기록 수)
        - 테이블 별칭: ACCESS_LOG A · MEMBER M (두 테이블에 같은 이름 MEMBER_ID가 있어서 어느 쪽인지 앞에 붙임)
        - TO_CHAR(날짜, 'YYYY-MM-DD HH24:MI:SS'): 날짜를 글자로 바꿈 (DTO가 String이라 모양을 정해서 보냄 · 시는 24시간제)
        - COUNT(CASE WHEN A.RESULT = 'FAIL' THEN 1 END) OVER (PARTITION BY A.IP_ADDRESS)
            : 행을 줄이지 않고, 같은 IP끼리 묶은 그룹 안의 FAIL 수를 각 행 옆에 붙여 줌 (분석 함수 · GROUP BY와 달리 행 수 그대로)
            : CASE WHEN ... THEN 1 END 는 FAIL이면 1, 아니면 NULL → COUNT는 NULL을 세지 않으니 FAIL만 셈
            : WHERE(기간 · IP 검색) 뒤, 페이지 자르기(OFFSET) 전에 계산 → 「검색한 기간 안의 그 IP 실패 수」
    -->
    <select id="selectAccessLogs" resultType="com.hoperefund.admin.dto.AccessLogResponseDto">
        SELECT
            A.LOG_ID AS accessId,
            A.MEMBER_ID AS memberId,
            A.SCREEN AS screen,
            TO_CHAR(A.ACCESSED_AT, 'YYYY-MM-DD HH24:MI:SS') AS accessedAt,
            A.IP_ADDRESS AS ipAddress,
            A.RESULT AS result,
            M.LOGIN_FAIL_COUNT AS failCount,
            TO_CHAR(M.LOCKED_UNTIL, 'YYYY-MM-DD HH24:MI:SS') AS lockedUntil,
            COUNT(CASE WHEN A.RESULT = 'FAIL' THEN 1 END) OVER (PARTITION BY A.IP_ADDRESS) AS ipFailCount
        FROM ACCESS_LOG A
        LEFT JOIN MEMBER M ON M.MEMBER_ID = A.MEMBER_ID
        <include refid="searchCondition"/>
        ORDER BY A.LOG_ID DESC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <!--
        [추가 11/20] 검색 조건에 맞는 전체 기록 수
        이유(PR #45 리뷰 ③): 전체 개수(total)가 있어야 화면이 총 페이지 수를 그림 (PageMeta.of(page, size, total))
        MEMBER는 조건에 쓰지 않아 JOIN 없이 ACCESS_LOG만 센다 (LEFT JOIN이라 행 수가 같음)
    -->
    <select id="countAccessLogs" resultType="int">
        SELECT COUNT(*)
        FROM ACCESS_LOG A
        <include refid="searchCondition"/>
    </select>

</mapper>
