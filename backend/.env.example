# 이 파일을 복사해서 backend/.env 로 만들고 값을 채워요 (.env는 커밋하지 않아요)
# DB 접속 정보 · 토큰은 팀 단톡에만 있어요. 노션·GitHub에 올리지 마세요.
# (STS Run Configurations의 환경변수로 넣어도 돼요. 둘 다 있으면 환경변수가 우선)

# ───── 필수 (README 4.1 표 · 비어 있으면 서버가 켜지지 않거나 기능이 동작하지 않아요) ─────
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 로그인 토큰(JWT) 서명 비밀키 · 32바이트 이상 아무 값 (CALC_API_TOKEN과 다른 값 · 팀원마다 달라도 됨)
#   없거나 짧으면 서버가 켜지지 않아요. 만드는 법(Git Bash): openssl rand -base64 48
JWT_SECRET=
# 계산 서버 내부 인증 토큰 · 계산 서버 calc/.env의 CALC_API_TOKEN과 같은 값
#   카드 업로드(POST /card/parse)는 CALC_MODE와 관계없이 항상 이 토큰을 써요
#   CALC_MODE=http인데 비어 있으면 서버가 켜지지 않아요
CALC_API_TOKEN=
# 챗봇 서버 내부 인증 토큰 · 챗봇 서버 chatbot/.env의 CHATBOT_API_TOKEN과 같은 값
#   비어 있으면 서버가 켜지지 않아요
CHATBOT_API_TOKEN=

# ───── 기본값이 있어서 바꿀 때만 앞의 #을 지우고 넣어요 (README 4.2 표) ─────
# 파이썬 계산 서버를 연결할 때 (안 넣으면 가짜 계산 mock)
# ⚠ 실제 서비스(배포)에서는 CALC_MODE=http 필수 — 비우면 가짜 계산(결정세액 0 · 기납부세액 전부 환급)이 나가요
# CALC_MODE=http
# CALC_BASE_URL=http://localhost:8000
# SAVE_ENABLED=true
# JWT_EXPIRATION=2h          # 로그인 유지 시간 (지나면 다시 로그인)
# LOGIN_LOCK_ENABLED=true    # 5번 틀리면 10분 잠금 (false면 끔)
# SERVER_PORT=8080
# Python FAQ 챗봇 서버 주소
# CHATBOT_BASE_URL=http://localhost:8001
