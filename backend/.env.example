# 이 파일을 복사해서 backend/.env 로 만들고 값을 채워요 (.env는 커밋하지 않아요)
# DB 접속 정보는 팀 단톡에만 있어요. 노션·GitHub에 올리지 마세요.
# (STS Run Configurations의 환경변수로 넣어도 돼요. 둘 다 있으면 환경변수가 우선)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 아래는 파이썬 계산 서버를 연결할 때만 앞의 #을 지우고 값을 넣어요 (안 넣으면 가짜 계산 mock)
# CALC_MODE=http
# CALC_BASE_URL=http://localhost:8000
# CALC_API_TOKEN=계산 서버 .env와 같은 값
# SAVE_ENABLED=true
