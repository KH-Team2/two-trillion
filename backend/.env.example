# 이 파일을 복사해서 backend/.env 로 만들고 값을 채워요 (.env는 커밋하지 않아요)
# DB 접속 정보는 팀 단톡에만 있어요. 노션·GitHub에 올리지 마세요.
# (STS Run Configurations의 환경변수로 넣어도 돼요. 둘 다 있으면 환경변수가 우선)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# 아래는 파이썬 계산 서버를 연결할 때만 앞의 #을 지우고 값을 넣어요 (안 넣으면 가짜 계산 mock)
# ⚠ 실제 서비스(배포)에서는 CALC_MODE=http 필수 — 비우면 가짜 계산(결정세액 0 · 기납부세액 전부 환급)이 나가요
#   http인데 CALC_API_TOKEN이 비어 있으면 서버가 켜지지 않아요
# CALC_MODE=http
# CALC_BASE_URL=http://localhost:8000
# CALC_API_TOKEN=계산 서버 .env와 같은 값
# SAVE_ENABLED=true
# 로그인 토큰(JWT) 서명 비밀키 — 필수 · 32바이트 이상 아무 값 (CALC_API_TOKEN과 다른 값 · 팀원마다 달라도 됨)
#   없거나 짧으면 서버가 켜지지 않아요. 만드는 법(Git Bash): openssl rand -base64 48
JWT_SECRET=
# 아래는 바꿀 때만 앞의 #을 지워요
# JWT_EXPIRATION=2h          # 로그인 유지 시간 (지나면 다시 로그인)
# LOGIN_LOCK_ENABLED=true    # 5번 틀리면 10분 잠금 (false면 끔)
