# 이 파일을 복사해서 calc/.env 로 만들고 값을 채워요 (.env는 커밋하지 않아요)
# DB 접속 정보는 팀 단톡에만 있어요. 노션·GitHub에 올리지 마세요.

# Oracle DB 연결 정보 — 계산 서버 전용 읽기 계정 (기준값 테이블 3개만 읽기 · ../database/README.md 참고)
# 테이블 주인 계정은 쓰지 않아요
DB_USERNAME=
DB_PASSWORD=
# python-oracledb는 JDBC 주소가 아니라 「주소:포트/서비스이름」 모양을 써요 (예: 127.0.0.1:1521/XEPDB1)
DB_DSN=

# Spring Boot와 Calc 서버 간 인증 (X-Calc-Token 헤더) — backend/.env의 CALC_API_TOKEN과 같은 값
# 필수: 비우면 계산 서버가 모든 요청을 막아요 (503 TOKEN_NOT_SET)
CALC_API_TOKEN=

# FastAPI 실행 환경
CALC_HOST=127.0.0.1
CALC_PORT=8000
