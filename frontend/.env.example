VITE_TERMS_VERSION=1.0
VITE_PRIVACY_VERSION=1.0
VITE_FINANCE_VERSION=1.0

# 회원가입 이메일 인증 화면 (true일 때만 보임 · 비우면 숨김)
# 켤 때는 backend/.env의 EMAIL_VERIFICATION_REQUIRED=true도 같이
VITE_EMAIL_VERIFICATION_REQUIRED=

# 개발용 API 연결 (운영 배포에는 넣지 않아요)
# Spring 서버 주소 (npm run dev 프록시가 /api 를 여기로 넘겨요 · 비우면 http://localhost:8080)
VITE_API_PROXY=
